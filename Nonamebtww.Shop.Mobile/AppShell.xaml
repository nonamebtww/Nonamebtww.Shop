<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Nonamebtww.Shop.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:auth="clr-namespace:Nonamebtww.Shop.Mobile.Views.Auth"
    xmlns:catalog="clr-namespace:Nonamebtww.Shop.Mobile.Views.Catalog"
    xmlns:favorites="clr-namespace:Nonamebtww.Shop.Mobile.Views.Favorites"
    xmlns:cart="clr-namespace:Nonamebtww.Shop.Mobile.Views.Cart"
    xmlns:orders="clr-namespace:Nonamebtww.Shop.Mobile.Views.Orders"
    xmlns:profile="clr-namespace:Nonamebtww.Shop.Mobile.Views.Profile"
    Shell.FlyoutBehavior="Disabled"
    Title="Nonamebtww Shop">

    <ShellContent
        Route="startup"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:StartupPage}" />

    <ShellContent
        Route="login"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate auth:LoginPage}" />

    <TabBar Route="main">
        <Tab Title="Каталог" Icon="hero_squares_2x2.png" Route="catalog">
            <ShellContent ContentTemplate="{DataTemplate catalog:CatalogPage}" />
        </Tab>
        <Tab Title="Избранное" Icon="hero_heart.png" Route="favorites">
            <ShellContent ContentTemplate="{DataTemplate favorites:FavoritesPage}" />
        </Tab>
        <Tab Title="Корзина" Icon="hero_shopping_cart.png" Route="cart">
            <ShellContent ContentTemplate="{DataTemplate cart:CartPage}" />
        </Tab>
        <Tab Title="Заказы" Icon="hero_clipboard_document_list.png" Route="orders">
            <ShellContent ContentTemplate="{DataTemplate orders:OrdersPage}" />
        </Tab>
        <Tab Title="Профиль" Icon="hero_user.png" Route="profile">
            <ShellContent ContentTemplate="{DataTemplate profile:ProfilePage}" />
        </Tab>
    </TabBar>
</Shell>
