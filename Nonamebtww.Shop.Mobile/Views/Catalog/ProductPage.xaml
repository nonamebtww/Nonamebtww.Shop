<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Catalog.ProductPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Catalog"
    xmlns:items="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Items"
    x:DataType="vm:ProductViewModel"
    Shell.TabBarIsVisible="False"
    Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Поделиться" Command="{Binding ShareCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="0,0,0,16" Spacing="12" IsVisible="{Binding IsLoaded}">
                <!-- Photos -->
                <CarouselView ItemsSource="{Binding Photos}" HeightRequest="300" IndicatorView="photoIndicator" Loop="False">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Image Source="{Binding .}" Aspect="AspectFill" />
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <IndicatorView x:Name="photoIndicator" HorizontalOptions="Center" />

                <VerticalStackLayout Padding="16,0" Spacing="8">
                    <Label Text="{Binding CategoryName}" Style="{StaticResource CaptionLabel}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Name}" Style="{StaticResource TitleLabel}" FontSize="22" />
                        <ImageButton Grid.Column="1" Source="{Binding IsFavorite, Converter={StaticResource FavoriteIcon}}"
                                Style="{StaticResource FavoriteButton}" VerticalOptions="Start" Command="{Binding ToggleFavoriteCommand}" />
                    </Grid>
                    <Label Text="{Binding RatingText}" Style="{StaticResource CaptionLabel}" />
                    <Label Text="{Binding PriceText}" Style="{StaticResource PriceLabel}" FontSize="24" />
                    <Label Text="{Binding StockText}" Style="{StaticResource CaptionLabel}" />
                    <Label Text="{Binding SkuText}" Style="{StaticResource CaptionLabel}" />

                    <Label Text="Описание" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding Description}" Style="{StaticResource BodyLabel}" />

                    <Label Text="Характеристики" Style="{StaticResource SectionLabel}" IsVisible="{Binding Characteristics, Converter={StaticResource IsNotEmpty}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Characteristics}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:SpecItem">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Label Text="{Binding Name}" Style="{StaticResource CaptionLabel}" />
                                    <Label Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyLabel}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding ReviewsTitle}" Style="{StaticResource SectionLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reviews}" Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Text="Отзывов пока нет" Style="{StaticResource CaptionLabel}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:ReviewItem">
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Author}" Style="{StaticResource BodyLabel}" FontFamily="OpenSansSemibold" />
                                            <Label Grid.Column="1" Text="{Binding Stars}" TextColor="{StaticResource Warning}" />
                                        </Grid>
                                        <Label Text="{Binding Text}" Style="{StaticResource BodyLabel}" IsVisible="{Binding Text, Converter={StaticResource IsNotEmpty}}" />
                                        <Label Text="{Binding Date}" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- New review -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding CanReview}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ваш отзыв" Style="{StaticResource SectionLabel}" Margin="0" />
                            <HorizontalStackLayout Spacing="2">
                                <Button Text="{Binding Star1}" Style="{StaticResource IconButton}" TextColor="{StaticResource Warning}" Command="{Binding SetRatingCommand}" CommandParameter="1" />
                                <Button Text="{Binding Star2}" Style="{StaticResource IconButton}" TextColor="{StaticResource Warning}" Command="{Binding SetRatingCommand}" CommandParameter="2" />
                                <Button Text="{Binding Star3}" Style="{StaticResource IconButton}" TextColor="{StaticResource Warning}" Command="{Binding SetRatingCommand}" CommandParameter="3" />
                                <Button Text="{Binding Star4}" Style="{StaticResource IconButton}" TextColor="{StaticResource Warning}" Command="{Binding SetRatingCommand}" CommandParameter="4" />
                                <Button Text="{Binding Star5}" Style="{StaticResource IconButton}" TextColor="{StaticResource Warning}" Command="{Binding SetRatingCommand}" CommandParameter="5" />
                            </HorizontalStackLayout>
                            <Border Style="{StaticResource FieldBorder}">
                                <Editor Placeholder="Расскажите о товаре" Text="{Binding ReviewText}" AutoSize="TextChanges" MinimumHeightRequest="80" />
                            </Border>
                            <Button Text="Отправить отзыв" Style="{StaticResource SecondaryButton}" Command="{Binding SubmitReviewCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />

        <!-- Buy bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" StrokeShape="Rectangle" Padding="16,10" IsVisible="{Binding IsLoaded}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                <Button Text="−" Style="{StaticResource StepButton}" Command="{Binding DecreaseCommand}" />
                <Label Grid.Column="1" Text="{Binding Quantity}" Style="{StaticResource PriceLabel}" VerticalTextAlignment="Center" WidthRequest="32" HorizontalTextAlignment="Center" />
                <Button Grid.Column="2" Text="+" Style="{StaticResource StepButton}" Command="{Binding IncreaseCommand}" />
                <Button Grid.Column="3" Text="{Binding CartButtonText}" Command="{Binding AddToCartCommand}" IsEnabled="{Binding InStock}" />
            </Grid>
        </Border>
    </Grid>
</views:ContentPageBase>
