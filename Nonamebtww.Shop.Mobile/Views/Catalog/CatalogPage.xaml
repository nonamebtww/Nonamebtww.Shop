<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Catalog.CatalogPage"
    x:TypeArguments="vm:CatalogViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Catalog"
    xmlns:items="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Items"
    xmlns:controls="clr-namespace:Nonamebtww.Shop.Mobile.Controls"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:DataType="vm:CatalogViewModel"
    Shell.TabBarIsVisible="True"
    Title="Каталог">

    <!-- Search and filters live in the navigation bar -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2" Padding="0,0,6,0" VerticalOptions="Center">
            <SearchBar Placeholder="Поиск товаров" Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}"
                       BackgroundColor="Transparent" VerticalOptions="Center" />
            <ImageButton Grid.Column="1" Style="{StaticResource BarIconButton}" Command="{Binding ToggleFiltersCommand}"
                         Source="{AppThemeBinding Light=hero_adjustments_horizontal.png, Dark=hero_adjustments_horizontal_dark.png}"
                         SemanticProperties.Description="Фильтры и сортировка" VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12,8,12,0" RowSpacing="8">

        <!-- Root categories -->
        <CollectionView ItemsSource="{Binding Categories}" ItemsLayout="HorizontalList" HeightRequest="44">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="items:CategoryChip">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Name}" FontSize="14" VerticalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, x:DataType=vm:CatalogViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Subcategories of the selected category -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding SubCategories}" ItemsLayout="HorizontalList" HeightRequest="40"
                        IsVisible="{Binding HasSubCategories}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="items:CategoryChip">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" Padding="12,5">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Name}" FontSize="13" VerticalTextAlignment="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectSubCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, x:DataType=vm:CatalogViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Filters panel -->
        <Border Grid.Row="2" Style="{StaticResource Card}" IsVisible="{Binding IsFiltersVisible}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Цена, ₽" Style="{StaticResource CaptionLabel}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Placeholder="от" Text="{Binding MinPrice}" Keyboard="Numeric" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                        <Entry Placeholder="до" Text="{Binding MaxPrice}" Keyboard="Numeric" />
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Только в наличии" Style="{StaticResource BodyLabel}" VerticalTextAlignment="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding OnlyInStock}" />
                </Grid>
                <Border Style="{StaticResource FieldBorder}">
                    <Picker Title="Сортировка" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Сбросить" Style="{StaticResource SecondaryButton}" Command="{Binding ResetFiltersCommand}" />
                    <Button Grid.Column="1" Text="Применить" Command="{Binding ApplyFiltersCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Products -->
        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Products}" RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,48" Spacing="8" HorizontalOptions="Center">
                        <Label Text="Ничего не найдено" Style="{StaticResource SectionLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="Попробуйте изменить запрос или фильтры" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:ProductCardItem">
                        <Border Style="{StaticResource Card}" Padding="8">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <Grid>
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="White" HeightRequest="130">
                                        <ff:CachedImage Source="{Binding Photo}" Aspect="AspectFit" HeightRequest="130"
                                                        LoadingPlaceholder="product_placeholder.png" ErrorPlaceholder="product_placeholder.png"
                                                        DownsampleToViewSize="True" FadeAnimationEnabled="True" />
                                    </Border>
                                    <ImageButton Source="{Binding IsFavorite, Converter={StaticResource FavoriteIcon}, ConverterParameter=black}" Style="{StaticResource PhotoBadgeButton}"
                                            SemanticProperties.Description="Избранное"
                                            HorizontalOptions="End" VerticalOptions="Start"
                                            Command="{Binding ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, x:DataType=vm:CatalogViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                                <Label Grid.Row="1" Text="{Binding Name}" Style="{StaticResource BodyLabel}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Text="{Binding RatingText}" Style="{StaticResource CaptionLabel}" />
                                <Label Grid.Row="3" Text="{Binding PriceText}" Style="{StaticResource PriceLabel}" />
                                <Button Grid.Row="4" Text="{Binding CartButtonText}" Padding="8,6" MinimumHeightRequest="36" IsEnabled="{Binding InStock}"
                                        Command="{Binding AddToCartCommand, Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, x:DataType=vm:CatalogViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenProductCommand, Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, x:DataType=vm:CatalogViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="96" Color="Transparent" BackgroundColor="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Skeleton while products load from the «API» -->
        <controls:ProductGridSkeleton Grid.RowSpan="4" Style="{StaticResource SkeletonOverlay}"
                                      IsVisible="{Binding IsLoading}" />
    </Grid>
</views:ContentPageBase>
