<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Admin.ProductEditPage"
    x:TypeArguments="vm:ProductEditViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Admin"
    xmlns:items="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Items"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:DataType="vm:ProductEditViewModel"
    Shell.TabBarIsVisible="False"
    Title="Товар">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}" />

            <Label Text="Категория" Style="{StaticResource CaptionLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Picker ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Title="Выберите категорию" />
            </Border>

            <Label Text="Артикул" Style="{StaticResource CaptionLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Text="{Binding Sku}" Placeholder="Например, SM-010" />
            </Border>
            <Label Text="Название" Style="{StaticResource CaptionLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Text="{Binding Name}" />
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Цена, ₽" Style="{StaticResource CaptionLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Price}" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Остаток, шт." Style="{StaticResource CaptionLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Stock}" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Описание" Style="{StaticResource CaptionLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Editor Text="{Binding Description}" AutoSize="TextChanges" MinimumHeightRequest="80" />
            </Border>

            <Label Text="Характеристики: по одной в строке, «Название: значение»" Style="{StaticResource CaptionLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Editor Text="{Binding Characteristics}" AutoSize="TextChanges" MinimumHeightRequest="80" />
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="В продаже" Style="{StaticResource BodyLabel}" VerticalTextAlignment="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsActive}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto">
                <Label Text="Фото" Style="{StaticResource SectionLabel}" />
                <Button Grid.Column="1" Text="Выбрать" Style="{StaticResource TextButton}" Command="{Binding PickPhotoCommand}" />
                <Button Grid.Column="2" Text="Удалить" Style="{StaticResource TextButton}" Command="{Binding RemovePhotoCommand}"
                        IsVisible="{Binding Photo, Converter={StaticResource IsNotEmpty}}" />
            </Grid>
            <ff:CachedImage Source="{Binding PhotoPreview}" HeightRequest="140" Aspect="AspectFit" HorizontalOptions="Start"
                            LoadingPlaceholder="product_placeholder.png" ErrorPlaceholder="product_placeholder.png" />

            <Button Text="Сохранить" Command="{Binding SaveCommand}" Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>
