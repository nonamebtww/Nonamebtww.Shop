<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Admin.UserDetailsPage"
    x:TypeArguments="vm:UserDetailsViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Admin"
    x:DataType="vm:UserDetailsViewModel"
    Shell.TabBarIsVisible="False"
    Title="Пользователь">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <!-- User card: one «Подпись: значение» per line -->
            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding NameText}" Style="{StaticResource TitleLabel}" FontSize="22" Margin="0,0,0,4" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Info}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoRow">
                                <Label Style="{StaticResource InfoLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Label}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                            <Span Text=": " TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                            <Span Text="{Binding Value}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsWarning}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Rights and blocking in one section -->
            <Label Text="Права и доступ" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Picker Title="Новая роль" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" />
            </Border>
            <Button Text="{Binding ChangeRoleText}" Command="{Binding ChangeRoleCommand}" />
            <Button Text="Заблокировать" Style="{StaticResource DangerButton}" Command="{Binding BlockCommand}"
                    IsVisible="{Binding IsBlocked, Converter={StaticResource InvertedBool}}" />
            <Button Text="Разблокировать" Style="{StaticResource SecondaryButton}" Command="{Binding UnblockCommand}" IsVisible="{Binding IsBlocked}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>
