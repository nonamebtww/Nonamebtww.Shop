<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Admin.AdminHubPage"
    x:TypeArguments="vm:AdminHubViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Admin"
    xmlns:items="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Items"
    x:DataType="vm:AdminHubViewModel"
    Shell.TabBarIsVisible="False"
    Title="Панель сотрудника">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="{Binding RoleText}" Style="{StaticResource CaptionLabel}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tiles}" Spacing="10">
                <BindableLayout.EmptyView>
                    <Label Text="Для вашей роли нет служебных разделов" Style="{StaticResource BodyLabel}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:StaffTile">
                        <Border Style="{StaticResource Card}" Padding="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="0" />
                                <Label Text="{Binding Description}" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:AdminHubViewModel}}, x:DataType=vm:AdminHubViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>
