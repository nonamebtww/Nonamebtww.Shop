<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Profile.ChangePasswordPage"
    x:TypeArguments="vm:ChangePasswordViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Profile"
    x:DataType="vm:ChangePasswordViewModel"
    Shell.TabBarIsVisible="False"
    Title="Смена пароля">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Border Style="{StaticResource FieldBorder}">
            <Entry Placeholder="Текущий пароль" Text="{Binding CurrentPassword}" IsPassword="True" />
        </Border>
        <Border Style="{StaticResource FieldBorder}">
            <Entry Placeholder="Новый пароль (от 8 символов, буквы и цифры)" Text="{Binding NewPassword}" IsPassword="True" />
        </Border>
        <Border Style="{StaticResource FieldBorder}">
            <Entry Placeholder="Повторите новый пароль" Text="{Binding ConfirmPassword}" IsPassword="True" />
        </Border>
        <Button Text="Сменить пароль" Command="{Binding SaveCommand}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
</views:ContentPageBase>
