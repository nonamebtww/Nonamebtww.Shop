<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Profile.ProfilePage"
    x:TypeArguments="vm:ProfileViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Profile"
    xmlns:controls="clr-namespace:Nonamebtww.Shop.Mobile.Controls"
    x:DataType="vm:ProfileViewModel"
    Shell.TabBarIsVisible="True"
    Title="Профиль">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="hero_bell.png" Text="Уведомления" Command="{Binding OpenNotificationsCommand}"
                     SemanticProperties.Description="Уведомления" />
    </ContentPage.ToolbarItems>

    <!-- Search in the navigation bar: finds products in the catalog -->
    <Shell.TitleView>
        <controls:SearchField Placeholder="Поиск товаров" Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}" Margin="0,0,8,0" />
    </Shell.TitleView>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,110" Spacing="20">
                <!-- Account -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 32"
                                BackgroundColor="{StaticResource Primary}" VerticalOptions="Center">
                            <Label Text="{Binding Initials}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding DisplayName}" Style="{StaticResource TitleLabel}" FontSize="20" />
                            <Label Text="{Binding LoginText}" Style="{StaticResource CaptionLabel}" FontSize="13" />
                            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                                    <Label Text="{Binding RoleText}" Style="{StaticResource BadgeLabel}" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="{Binding RegisteredText}" Style="{StaticResource CaptionLabel}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Account settings -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                            <Image Source="{AppThemeBinding Light=hero_identification.png, Dark=hero_identification_dark.png}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Личные данные и устройства" Style="{StaticResource BodyLabel}" FontSize="16" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=hero_chevron_right.png, Dark=hero_chevron_right_dark.png}" WidthRequest="16" HeightRequest="16" Opacity="0.4" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPersonalDataCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="0.5" Margin="48,0,0,0" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                        <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                            <Image Source="{AppThemeBinding Light=hero_key.png, Dark=hero_key_dark.png}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Сменить пароль" Style="{StaticResource BodyLabel}" FontSize="16" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=hero_chevron_right.png, Dark=hero_chevron_right_dark.png}" WidthRequest="16" HeightRequest="16" Opacity="0.4" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="0.5" Margin="48,0,0,0" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                        <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                            <Image Source="{AppThemeBinding Light=hero_clipboard_document_list.png, Dark=hero_clipboard_document_list_dark.png}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Мои заказы" Style="{StaticResource BodyLabel}" FontSize="16" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=hero_chevron_right.png, Dark=hero_chevron_right_dark.png}" WidthRequest="16" HeightRequest="16" Opacity="0.4" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenOrdersCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Staff entry point (manager, owner, logistician, courier) -->
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsStaff}">
                    <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                        <Image Source="{AppThemeBinding Light=hero_briefcase.png, Dark=hero_briefcase_dark.png}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Панель сотрудника" Style="{StaticResource BodyLabel}" FontSize="16" VerticalOptions="Center" />
                        <Image Grid.Column="2" Source="{AppThemeBinding Light=hero_chevron_right.png, Dark=hero_chevron_right_dark.png}" WidthRequest="16" HeightRequest="16" Opacity="0.4" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenStaffPanelCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="*">
                        <Label Text="Выйти из аккаунта" TextColor="{StaticResource Danger}" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:ProfileSkeleton Padding="16" Style="{StaticResource SkeletonOverlay}" IsVisible="{Binding IsLoading}" />
    </Grid>
</views:ContentPageBase>
