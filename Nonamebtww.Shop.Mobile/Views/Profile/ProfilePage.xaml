<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Profile.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Profile"
    xmlns:items="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Items"
    xmlns:notifications="clr-namespace:Nonamebtww.Shop.Mobile.Services.Notifications"
    x:DataType="vm:ProfileViewModel"
    Shell.TabBarIsVisible="True"
    Title="Профиль">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,110" Spacing="12">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding DisplayName}" Style="{StaticResource TitleLabel}" />
                    <Label Text="{Binding LoginText}" Style="{StaticResource CaptionLabel}" />
                    <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 10" HorizontalOptions="Start" Margin="0,4,0,0">
                        <Label Text="{Binding RoleText}" Style="{StaticResource BadgeLabel}" />
                    </Border>
                    <Label Text="{Binding RegisteredText}" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Панель сотрудника" Command="{Binding OpenStaffPanelCommand}" IsVisible="{Binding IsStaff}" />

            <Label Text="Личные данные" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Placeholder="Имя" Text="{Binding FirstName}" />
            </Border>
            <Border Style="{StaticResource FieldBorder}">
                <Entry Placeholder="Фамилия" Text="{Binding LastName}" />
            </Border>
            <Border Style="{StaticResource FieldBorder}">
                <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" IsSpellCheckEnabled="False" />
            </Border>
            <Border Style="{StaticResource FieldBorder}">
                <Entry Placeholder="Телефон" Text="{Binding Phone}" Keyboard="Telephone" />
            </Border>
            <Button Text="Сохранить изменения" Command="{Binding SaveCommand}" />
            <Button Text="Сменить пароль" Style="{StaticResource SecondaryButton}" Command="{Binding ChangePasswordCommand}" />

            <Label Text="Устройства" Style="{StaticResource SectionLabel}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Devices}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="items:DeviceItem">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" Style="{StaticResource BodyLabel}" />
                                    <Label Text="{Binding Details}" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Выйти" Style="{StaticResource TextButton}" IsVisible="{Binding CanSignOut}"
                                        Command="{Binding SignOutDeviceCommand, Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, x:DataType=vm:ProfileViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Уведомления" Style="{StaticResource SectionLabel}" />
            <Label Text="Письма, SMS и уведомления прототипа приходят сюда, без реальной отправки" Style="{StaticResource CaptionLabel}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notifications}" Spacing="8">
                <BindableLayout.EmptyView>
                    <Label Text="Уведомлений пока нет" Style="{StaticResource CaptionLabel}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="notifications:NotificationItem">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}" Style="{StaticResource BodyLabel}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Body}" Style="{StaticResource BodyLabel}" />
                                <Label Text="{Binding Time}" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Выйти из аккаунта" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>
