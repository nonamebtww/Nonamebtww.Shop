<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Auth.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Auth"
    x:DataType="vm:ForgotPasswordViewModel"
    Title="Восстановление пароля">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Восстановление пароля" Style="{StaticResource TitleLabel}" />
            <Label Text="Укажите логин, почту или телефон. Мы отправим код подтверждения." Style="{StaticResource BodyLabel}" />

            <Border Style="{StaticResource FieldBorder}">
                <Entry Placeholder="Логин, email или телефон" Text="{Binding Identifier}" IsEnabled="{Binding IsCodeStep, Converter={StaticResource InvertedBool}}"
                       Keyboard="Email" IsSpellCheckEnabled="False" />
            </Border>
            <Button Text="Получить код" Command="{Binding SendCodeCommand}" IsVisible="{Binding IsCodeStep, Converter={StaticResource InvertedBool}}" />

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsCodeStep}">
                <Label Text="{Binding CodeHint}" Style="{StaticResource CaptionLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="Код из 6 цифр" Text="{Binding Code}" Keyboard="Numeric" MaxLength="6" />
                </Border>
                <Border Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="Новый пароль" Text="{Binding NewPassword}" IsPassword="True" />
                </Border>
                <Border Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="Повторите пароль" Text="{Binding ConfirmPassword}" IsPassword="True" />
                </Border>
                <Button Text="Сменить пароль" Command="{Binding ResetCommand}" />
                <Button Text="Отправить код ещё раз" Style="{StaticResource TextButton}" Command="{Binding SendCodeCommand}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>
