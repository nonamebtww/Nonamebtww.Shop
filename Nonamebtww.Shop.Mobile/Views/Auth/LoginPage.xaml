<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Auth"
    xmlns:enums="clr-namespace:Nonamebtww.Shop.Application.Models.Enums;assembly=Nonamebtww.Shop.Application"
    x:DataType="vm:LoginViewModel"
    Title="Вход">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="14">
            <Label Text="Nonamebtww Shop" Style="{StaticResource TitleLabel}" FontSize="30" />
            <Label Text="Войдите по логину, почте или номеру телефона" Style="{StaticResource CaptionLabel}" />

            <Border Style="{StaticResource FieldBorder}" Margin="0,16,0,0">
                <Entry Placeholder="Логин, email или телефон" Text="{Binding Identifier}"
                       Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Next" />
            </Border>
            <Border Style="{StaticResource FieldBorder}">
                <Entry Placeholder="Пароль" Text="{Binding Password}" IsPassword="True"
                       ReturnType="Go" ReturnCommand="{Binding LoginCommand}" />
            </Border>

            <Button Text="Войти" Command="{Binding LoginCommand}" Margin="0,6,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Grid ColumnDefinitions="*,*">
                <Label Text="Забыли пароль?" Style="{StaticResource LinkLabel}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="Регистрация" Style="{StaticResource LinkLabel}" HorizontalTextAlignment="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Label Text="или войти через" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="Google" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExternalLoginCommand}" CommandParameter="{x:Static enums:ExternalAuthProvider.Google}" />
                <Button Grid.Column="1" Text="Apple ID" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExternalLoginCommand}" CommandParameter="{x:Static enums:ExternalAuthProvider.Apple}" />
                <Button Grid.Column="2" Text="Yandex ID" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExternalLoginCommand}" CommandParameter="{x:Static enums:ExternalAuthProvider.Yandex}" />
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Демо-аккаунты прототипа" Style="{StaticResource SectionLabel}" Margin="0" />
                    <Label Text="Нажмите, чтобы подставить логин и пароль" Style="{StaticResource CaptionLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DemoAccounts}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DemoAccount">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                    <Label Text="{Binding RoleCaption}" Style="{StaticResource BodyLabel}" />
                                    <Label Grid.Column="1" Text="{Binding Login}" Style="{StaticResource CaptionLabel}" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding FillDemoCommand, Source={RelativeSource AncestorType={x:Type vm:LoginViewModel}}, x:DataType=vm:LoginViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>
