<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.StartupPage"
    x:TypeArguments="vm:StartupViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels"
    x:DataType="vm:StartupViewModel"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
        <Label Text="Nonamebtww Shop" Style="{StaticResource TitleLabel}" FontSize="30" HorizontalTextAlignment="Center" />
        <ActivityIndicator IsRunning="True" />
        <Label Text="{Binding StatusText}" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</views:ContentPageBase>
