<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Cart.CheckoutPage"
    x:TypeArguments="vm:CheckoutViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Cart"
    xmlns:orders="clr-namespace:Nonamebtww.Shop.Application.Models.DTOs.Orders;assembly=Nonamebtww.Shop.Application"
    x:DataType="vm:CheckoutViewModel"
    Shell.TabBarIsVisible="False"
    Title="Оформление заказа">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <!-- Step 1: delivery and payment -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsPaymentStep, Converter={StaticResource InvertedBool}}">
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SummaryText}" Style="{StaticResource BodyLabel}" />
                        <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource PriceLabel}" />
                    </Grid>
                </Border>

                <Label Text="Способ получения" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DeliveryOptions}"
                                         RadioButtonGroup.GroupName="delivery"
                                         RadioButtonGroup.SelectedValue="{Binding SelectedDelivery}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeliveryOption">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,8" MinimumHeightRequest="56">
                                    <Image Source="{Binding Icon}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                        <Label Text="{Binding Caption}" Style="{StaticResource BodyLabel}" FontSize="16" />
                                        <Label Text="{Binding Hint}" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <RadioButton Grid.Column="2" GroupName="delivery" Value="{Binding .}" VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectDeliveryCommand, Source={RelativeSource AncestorType={x:Type vm:CheckoutViewModel}}, x:DataType=vm:CheckoutViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Courier: delivery address -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsToDoor}">
                    <Label Text="Адрес доставки" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Placeholder="Город" Text="{Binding City}" />
                    </Border>
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Placeholder="Улица" Text="{Binding Street}" />
                    </Border>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Placeholder="Дом" Text="{Binding House}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <Entry Placeholder="Кв." Text="{Binding Apartment}" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource FieldBorder}">
                            <Entry Placeholder="Индекс" Text="{Binding PostalCode}" Keyboard="Numeric" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Placeholder="Комментарий курьеру" Text="{Binding Comment}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Pickup / parcel locker: choose a point -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsToDoor, Converter={StaticResource InvertedBool}}">
                    <Label Text="{Binding PointsTitle}" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker Title="{Binding PointsTitle}" ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}"
                                ItemDisplayBinding="{Binding Name, x:DataType=orders:DeliveryPointDto}" />
                    </Border>
                    <Border Style="{StaticResource Card}" IsVisible="{Binding SelectedPoint, Converter={StaticResource IsNotEmpty}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=hero_map_pin.png, Dark=hero_map_pin_dark.png}" WidthRequest="22" HeightRequest="22" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding SelectedPoint.Name}" Style="{StaticResource BodyLabel}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding SelectedPoint.Address}" Style="{StaticResource BodyLabel}" />
                                <Label Text="{Binding SelectedPoint.Schedule, StringFormat='Часы работы: {0}'}" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label Text="Оплата онлайн" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <RadioButton Content="Банковская карта" GroupName="payment" IsChecked="{Binding IsCard}" />
                        <RadioButton Content="СБП" GroupName="payment" IsChecked="{Binding IsSbp}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Подтвердить заказ" Command="{Binding PlaceOrderCommand}" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <!-- Step 2: online payment through the payment system -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsPaymentStep}">
                <Label Text="Оплата заказа" Style="{StaticResource TitleLabel}" />
                <Label Text="{Binding OrderText}" Style="{StaticResource BodyLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Платёжная система (прототип)" Style="{StaticResource SectionLabel}" Margin="0" />
                        <Label Text="Данные карты не запрашиваются: платёж проводится локальной заглушкой платёжной системы."
                               Style="{StaticResource CaptionLabel}" />
                        <Label Text="{Binding TotalText}" Style="{StaticResource PriceLabel}" FontSize="24" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="{Binding PayButtonText}" Command="{Binding PayCommand}" />
                <Button Text="Оплатить позже" Style="{StaticResource TextButton}" Command="{Binding PayLaterCommand}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>
