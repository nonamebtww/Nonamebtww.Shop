<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="Nonamebtww.Shop.Mobile.Views.Favorites.FavoritesPage"
    x:TypeArguments="vm:FavoritesViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nonamebtww.Shop.Mobile.Views"
    xmlns:vm="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Favorites"
    xmlns:items="clr-namespace:Nonamebtww.Shop.Mobile.ViewModels.Items"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:DataType="vm:FavoritesViewModel"
    Shell.TabBarIsVisible="True"
    Title="Избранное">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Items}" Margin="12,8" ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,64" Spacing="8" HorizontalOptions="Center">
                    <Label Text="В избранном пусто" Style="{StaticResource SectionLabel}" HorizontalTextAlignment="Center" />
                    <Label Text="Отмечайте товары сердечком в каталоге" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="items:ProductCardItem">
                    <!-- Fixed-size row: 12 + 92 + 12 = 116 pt for every product -->
                    <Border Style="{StaticResource Card}" HeightRequest="116">
                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource ProductPhotoFrame}" HeightRequest="80" WidthRequest="80" VerticalOptions="Center">
                                <ff:CachedImage Source="{Binding Photo}"
                                                Aspect="AspectFill"
                                                FadeAnimationEnabled="False"
                                                RetryCount="3"
                                                RetryDelay="600"
                                                CacheDuration="30.00:00:00"
                                                HeightRequest="80"
                                                DownsampleHeight="80"
                                                DownsampleUseDipUnits="True"
                                                DownsampleToViewSize="True"
                                                BitmapOptimizations="True"
                                                ErrorPlaceholder="product_placeholder.png"
                                                InputTransparent="True" />
                            </Border>
                            <Grid Grid.Column="1" RowDefinitions="40,22,16" RowSpacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource BodyLabel}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="1" Text="{Binding PriceText}" Style="{StaticResource PriceLabel}" MaxLines="1" />
                                <Label Grid.Row="2" Text="{Binding StockText}" Style="{StaticResource CaptionLabel}" MaxLines="1" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                <ImageButton Source="{AppThemeBinding Light=hero_heart_solid.png, Dark=hero_heart_solid_dark.png}" Style="{StaticResource BarIconButton}"
                                        SemanticProperties.Description="Убрать из избранного"
                                        Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, x:DataType=vm:FavoritesViewModel}"
                                        CommandParameter="{Binding .}" />
                                <ImageButton Source="{AppThemeBinding Light=hero_shopping_cart.png, Dark=hero_shopping_cart_dark.png}" Style="{StaticResource BarIconButton}"
                                        SemanticProperties.Description="В корзину" IsEnabled="{Binding InStock}"
                                        Command="{Binding AddToCartCommand, Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, x:DataType=vm:FavoritesViewModel}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenProductCommand, Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, x:DataType=vm:FavoritesViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="96" Color="Transparent" BackgroundColor="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</views:ContentPageBase>
